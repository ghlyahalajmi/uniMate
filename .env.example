# ---------------------------------------------------------------------------
# UniMate environment
# Copy to .env.local for development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
# The publishable (anon) key is safe in the browser: row level security, not
# key secrecy, is what keeps one student's data away from another's.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Anthropic — console.anthropic.com
# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Leave it unset and UniMate still runs: grades, GPA, tasks, reminders and the
# calendar are all computed locally, and the AI screens explain what is missing.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the agents run on.
# ANTHROPIC_MODEL=claude-opus-5

# Optional: shared secret for the workflow webhooks under /api/workflows/*,
# so an automation platform (n8n, Make, a cron job) can trigger them.
# Leave unset to disable those endpoints entirely.
# WORKFLOW_WEBHOOK_SECRET=generate-a-long-random-string

# Used in password-reset emails and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
